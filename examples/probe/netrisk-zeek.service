[Unit]
Description=NetRisk separately provisioned passive Zeek capture worker
After=local-fs.target
ConditionPathExists=/etc/netrisk-probe/capture-approved

[Service]
Type=simple
User=netrisk-capture
Group=netrisk-capture
WorkingDirectory=/var/lib/netrisk-probe/zeek
ExecStartPre=/usr/local/bin/safecadence-local probe verify-engine --manifest /etc/netrisk-probe/zeek-engine.json
ExecStart=/opt/netrisk-engines/zeek/bin/zeek -i capture0 LogAscii::use_json=T
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_RAW
AmbientCapabilities=CAP_NET_RAW
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/netrisk-probe/zeek
RestrictAddressFamilies=AF_PACKET AF_UNIX
IPAddressDeny=any
RestrictNamespaces=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
LimitCORE=0
TasksMax=128

[Install]
WantedBy=multi-user.target
